# ============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ============================================================================

# Database (PostgreSQL with pgvector extension)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/classmate_db?schema=public"

# Google Gemini API Key (for 768-d embeddings and LLM grounded responses)
GEMINI_API_KEY="your-gemini-api-key"

# JWT Authentication Secret
JWT_SECRET="your-secure-random-jwt-secret-key"

# ============================================================================
# GOOGLE CLOUD STORAGE (GCS) FILE STORAGE
# ============================================================================
# Private GCS Bucket where original PDF files are stored
GCS_BUCKET_NAME="your-gcs-bucket-name"

# Optional: Google Cloud Project ID
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"

# Google Cloud Authentication Options:
# Option 1 (Local Dev Recommended): Run `gcloud auth application-default login`
# Option 2: Path to downloaded Service Account JSON key:
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"
# Option 3 (Vercel / Cloud Deployments): Stringified JSON content of service account key:
# GCS_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# ============================================================================
# AWS S3 (Optional / Alternative Storage)
# ============================================================================
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_S3_BUCKET_NAME="your-s3-bucket-name"
